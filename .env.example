# --- Identifiants partagés ---
# Les 3 collègues se connectent avec le MÊME compte (un seul login/mdp).
AUTH_USERNAME=vibaura
AUTH_PASSWORD=change-moi-stp

# Secret utilisé pour signer les cookies de session.
# Mets une longue chaîne aléatoire, par ex: openssl rand -hex 32
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire

# Port interne du serveur (nginx fait le proxy vers ce port).
# 8790 par défaut pour ne pas entrer en conflit avec d'autres services (ex: 3000/3001).
PORT=8790

# Emplacement du fichier SQLite (monté en volume Docker).
DB_PATH=./data/timeline.db

# production => cookies "secure" (HTTPS requis, ce que fait ton nginx).
NODE_ENV=production
