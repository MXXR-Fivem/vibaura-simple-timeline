# Copie ce fichier en .env puis remplace les DEUX valeurs CHANGE_ME.
# Le serveur REFUSE de démarrer en production tant qu'elles ne sont pas changées.

# --- Identifiants partagés ---
# Les 3 collègues se connectent avec le MÊME compte (un seul login/mdp).
AUTH_USERNAME=vibaura
# Mets un mot de passe fort et unique (CHANGE_ME est refusé au démarrage).
AUTH_PASSWORD=CHANGE_ME

# Secret utilisé pour signer les cookies de session.
# Génère-le : openssl rand -hex 32   (CHANGE_ME et < 32 caractères sont refusés).
SESSION_SECRET=CHANGE_ME

# Port interne du serveur (nginx fait le proxy vers ce port).
# 8790 par défaut pour ne pas entrer en conflit avec d'autres services (ex: 3000/3001).
PORT=8790

# Emplacement du fichier SQLite (monté en volume Docker).
DB_PATH=./data/timeline.db

# Dossier des assets du front. Par défaut <racine du projet>/dist, ce qui convient
# aussi bien en dev qu'une fois compilé : à ne renseigner que si tu sers le front
# depuis un autre emplacement.
# PUBLIC_DIR=./dist

# NODE_ENV=production (cookies "secure", HTTPS requis) est fourni par Docker
# (Dockerfile + docker-compose). Hors Docker en prod, le serveur étant en
# TypeScript, il faut compiler avant de démarrer :
#   npm run build && NODE_ENV=production npm start
