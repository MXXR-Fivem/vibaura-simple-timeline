{
  "name": "vibaura-simple-timeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Timeline collaborative simple et légère (React + Express + SQLite)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --import tsx --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "start": "node build/server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^6.0.7"
  }
}
